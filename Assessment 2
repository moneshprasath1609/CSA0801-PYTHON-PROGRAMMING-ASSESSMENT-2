def normalise(text):
    return text.strip().replace(" ", "").replace("-", "").upper()


def is_valid(reg):
    if len(reg) not in (9, 10):
        return False

    return (
        reg[:2].isalpha()
        and reg[2:4].isdigit()
        and reg[4:-4].isalpha()
        and len(reg[4:-4]) in (1, 2)
        and reg[-4:].isdigit()
    )


def format_reg(reg):
    if not is_valid(reg):
        raise ValueError("Invalid registration number")

    return f"{reg[:2]} {reg[2:4]} {reg[4:-4]} {reg[-4:]}"


