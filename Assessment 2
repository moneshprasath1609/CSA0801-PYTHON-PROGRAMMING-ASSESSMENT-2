from functools import lru_cache

calls = 0


def ways_naive(n):
    global calls
    calls += 1

    if n <= 1:
        return 1

    return ways_naive(n-1) + ways_naive(n-2)


@lru_cache(maxsize=None)
def ways_memo(n):
    global calls
    calls += 1

    if n <= 1:
        return 1

    return ways_memo(n-1) + ways_memo(n-2)


def ways_loop(n):
    if n <= 1:
        return 1

    a, b = 1, 1

    for _ in range(2, n+1):
        a, b = b, a+b

    return b


