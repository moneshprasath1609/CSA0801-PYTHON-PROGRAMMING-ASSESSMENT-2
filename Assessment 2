def separate_if(units, ration, senior):
    result = []

    if units <= 100:
        result.append("Full subsidy")

    if 101 <= units <= 200 and ration:
        result.append("Partial subsidy")

    if units > 200 and senior:
        result.append("Special subsidy")

    if not result:
        result.append("No subsidy")

    return result


def one_decision(units, ration, senior):
    if units <= 100:
        return "Full subsidy"
    elif 101 <= units <= 200 and ration:
        return "Partial subsidy"
    elif units > 200 and senior:
        return "Special subsidy"
    else:
        return "No subsidy"


